{
  "name": "english-quest",
  "private": true,
  "version": "0.11.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 4175",
    "generate:icons": "tsx scripts/generate-icons.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write src tests scripts *.ts *.json *.html *.js docs/DECISIONS.md README.md --ignore-path .prettierignore",
    "format:check": "prettier --check src tests scripts *.ts *.json *.html *.js docs/DECISIONS.md README.md --ignore-path .prettierignore",
    "test": "vitest run",
    "build": "npm run validate:content && tsc --noEmit && vite build",
    "build:demo": "npm run validate:content && tsc --noEmit && vite build --mode demo",
    "build:android:assets": "npm run validate:content && tsc --noEmit && vite build --mode android-demo --outDir dist-android",
    "android:build": "node scripts/build-android.mjs",
    "android:sync": "cap sync android",
    "android:serve": "node scripts/serve-android-download.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test:e2e": "playwright test",
    "test:e2e:production": "playwright test --config playwright.production.config.ts",
    "validate:content": "tsx scripts/validate-content.ts && npm run validate:wordbooks && npm run validate:courses",
    "wordbooks:sync": "tsx scripts/sync-wordbooks.ts",
    "validate:wordbooks": "tsx scripts/sync-wordbooks.ts --check",
    "validate:courses": "tsx scripts/validate-courses.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/preferences": "^8.0.1",
    "dexie": "^4.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
